# LINE Messaging API（v1 先單一 channel,multi-tenant 從 DB 讀)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 預設 tenant（v1 家裡用,之後 admin panel 切換）
DEFAULT_TENANT_ID=

# Phase 34:攤位金流金鑰的加密金鑰(32 bytes base64;Vercel 與本機要用同一把,不然本機看正式 DB 會解不開)
# 產生:openssl rand -base64 32   或   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 遺失 = 所有攤位的金流金鑰要重填。請另外備份在密碼管理器。
PAYMENT_CONFIG_KEY=

# 愛油哇過渡期退路(DEFAULT_TENANT_ID 的攤位 DB 沒金鑰時才讀;後台匯入後可刪)
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# 本機沙盒(設了會讓所有攤位走測試站、忽略 DB 金鑰;正式站不要設)
LINEPAY_ENV=
LINEPAY_SANDBOX_CHANNEL_ID=
LINEPAY_SANDBOX_CHANNEL_SECRET=
ECPAY_ENV=
